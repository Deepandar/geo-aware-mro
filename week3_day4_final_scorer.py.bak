# -*- coding: utf-8 -*-
"""
GEO-AWARE MRO DECISION INTELLIGENCE SYSTEM
Week 3 · Day 4 (Thursday) — 27-Class Taxonomy + Composite Index

CONTEXT (what was built Mon-Wed):
  W3-Mon: ABC classifier (ACV, Pareto cutoffs) → abc_class
  W3-Tue: VED classifier (equipment density, location scoring) → ved_class
  W3-Wed: FNS classifier (ADI/CV², Syntetos-Boylan) → fns_class, demandclass

WHAT THIS SCRIPT DOES:
  1. Loads the W3-Wed output (with ABC, VED, FNS)
  2. Computes the composite index C_i with tunable weights
  3. Creates the 27-class taxonomy cell (ABC×VED×FNS)
  4. Saves final output as skumaster500.parquet for W3D5 report
"""

import numpy as np
import pandas as pd
import duckdb
import mlflow
from pathlib import Path

# ─────────────────────────────────────────────────────────────
# 1. CONFIGURATION
# ─────────────────────────────────────────────────────────────
DATADIR = Path("data/processed")
DBPATH = DATADIR / "mro.duckdb"
MLFLOW_URI = "sqlite:///mlflow/mlflow.db"

# Composite Index weights (must sum to 1.0)
WEIGHTS = {
    "abc": 0.35,  # Value contribution
    "ved": 0.30,  # Criticality
    "fns": 0.20,  # Demand pattern
    "loc": 0.15   # Location tier
}

# Syntetos-Boylan thresholds (must match W3D3)
ADI_BOUNDARY = 1.32
CV2_BOUNDARY = 0.49

# Ensure directories exist
DATADIR.mkdir(parents=True, exist_ok=True)
Path("mlflow").mkdir(exist_ok=True)

mlflow.set_tracking_uri(MLFLOW_URI)

print("═" * 70)
print("🏁 WEEK 3 · DAY 4 — 27-Class Taxonomy + Composite Index")
print("═" * 70)

# ─────────────────────────────────────────────────────────────
# 2. DATA LOADING
# ─────────────────────────────────────────────────────────────
def load_sku_master(dbpath: Path = DBPATH) -> pd.DataFrame:
    """
    Load SKU data from W3D3 output.
    Expected columns: abc_class, ved_class, fns_class, adi, cv2, locationtype
    """
    con = duckdb.connect(str(dbpath), read_only=True)
    
    # Try multiple table name variants
    tables = con.execute("SHOW TABLES").df()
    tablenames = tables['name'].tolist() if 'name' in tables.columns else []
    
    target_table = None
    for candidate in ["sku_master_final", "sku_master", "skumaster"]:
        if candidate in tablenames:
            target_table = candidate
            break
    
    if not target_table:
        con.close()
        raise ValueError(f"No SKU master table found. Tables: {tablenames}")
    
    df = con.execute(f"SELECT * FROM {target_table}").df()
    con.close()
    
    # Rename columns to match W3D5 expectations (no underscores)
    rename_map = {
        "abc_class": "abcclass",
        "ved_class": "vedclass",
        "fns_class": "fnsclass",
        "location_tier": "locationtype"  # W3D2 output
    }
    
    for src, tgt in rename_map.items():
        if src in df.columns and tgt not in df.columns:
            df = df.rename(columns={src: tgt})
    
    # Validate required columns
    required = ["abcclass", "vedclass", "fnsclass", "adi", "cv2"]
    missing = [c for c in required if c not in df.columns]
    
    if missing:
        print(f"❌ ERROR: Missing columns {missing}")
        print(f"Available columns: {df.columns.tolist()}")
        raise ValueError(f"Missing required columns: {missing}")
    
    print(f"✅ Loaded {len(df)} SKUs from table '{target_table}'")
    return df

# ─────────────────────────────────────────────────────────────
# 3. COMPOSITE INDEX ENGINE
# ─────────────────────────────────────────────────────────────
def compute_composite_index(df: pd.DataFrame) -> pd.DataFrame:
    """
    Compute C_i composite index using normalized class scores.
    
    Formula:
      C_i = w_ABC × s_ABC + w_VED × s_VED + w_FNS × s_FNS + w_Loc × s_Loc
    
    Score mapping:
      ABC: A→1.0, B→0.5, C→0.0
      VED: V→1.0, E→0.5, D→0.0
      FNS: F→0.0, N→0.5, S→1.0  (inverted: Slow is high priority)
      Loc: Forward→1.0, Border→0.6, Rear→0.0
    """
    df = df.copy()
    
    # Score maps
    abc_score = {"A": 1.0, "B": 0.5, "C": 0.0}
    ved_score = {"V": 1.0, "E": 0.5, "D": 0.0}
    fns_score = {"F": 0.0, "N": 0.5, "S": 1.0}  # Inverted: Slow → high score
    loc_score = {"Forward": 1.0, "Border": 0.6, "Rear": 0.0}
    
    # Map classes to scores
    df["abcscore"] = df["abcclass"].map(abc_score)
    df["vedscore"] = df["vedclass"].map(ved_score)
    df["fnsscore"] = df["fnsclass"].map(fns_score)
    
    # Location score (handle missing locationtype)
    if "locationtype" in df.columns:
        df["locscore"] = df["locationtype"].map(loc_score).fillna(0.5)
    else:
        print("⚠️  WARNING: 'locationtype' column missing. Setting loc score = 0.5 for all SKUs.")
        df["locscore"] = 0.5
    
    # Compute composite index
    df["ci"] = (
        WEIGHTS["abc"] * df["abcscore"] +
        WEIGHTS["ved"] * df["vedscore"] +
        WEIGHTS["fns"] * df["fnsscore"] +
        WEIGHTS["loc"] * df["locscore"]
    ).clip(0, 1).round(4)
    
    print(f"✅ Composite index computed: mean={df['ci'].mean():.4f}, std={df['ci'].std():.4f}")
    return df

# ─────────────────────────────────────────────────────────────
# 4. TAXONOMY CELL ASSIGNMENT
# ─────────────────────────────────────────────────────────────
def assign_taxonomy_cells(df: pd.DataFrame) -> pd.DataFrame:
    """
    Create 27-class taxonomy by concatenating ABC × VED × FNS.
    
    Examples:
      A-V-F → "AVF" (high-value, vital, smooth)
      B-E-N → "BEN" (medium-value, essential, erratic)
      C-D-S → "CDS" (low-value, desirable, lumpy)
    """
    df = df.copy()
    
    # Concatenate classification dimensions
    df["taxonomycell"] = (
        df["abcclass"].str.upper() + 
        df["vedclass"].str.upper() + 
        df["fnsclass"].str.upper()
    )
    
    # Validate 27 possible cells
    unique_cells = df["taxonomycell"].nunique()
    total_possible = 3 * 3 * 3  # ABC × VED × FNS
    
    print(f"✅ Taxonomy cells created: {unique_cells}/{total_possible} cells active")
    
    # Show top 5 most populated cells
    top_cells = df["taxonomycell"].value_counts().head(5)
    print("\n📊 Top 5 populated cells:")
    for cell, count in top_cells.items():
        pct = count / len(df) * 100
        print(f"   {cell}: {count} SKUs ({pct:.1f}%)")
    
    return df

# ─────────────────────────────────────────────────────────────
# 5. QUADRANT VALIDATION
# ─────────────────────────────────────────────────────────────
def validate_demand_coverage(df: pd.DataFrame) -> None:
    """
    Ensures all 4 Syntetos-Boylan demand quadrants are represented.
    Critical for Phase 2 forecast routing readiness.
    """
    freq = df['adi'] < ADI_BOUNDARY
    stable = df['cv2'] < CV2_BOUNDARY
    
    quadrants =